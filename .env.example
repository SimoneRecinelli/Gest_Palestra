# Connection string di Neon (dashboard Neon -> Connection Details)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=genera-una-stringa-casuale-lunga

# In locale lascia questo, su Vercel mettici l'URL pubblico del sito
NEXTAUTH_URL=http://localhost:3000

# Da Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SUPABASE_BUCKET=video-esercizi
